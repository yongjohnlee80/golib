    7-9 fg=muted bg=background
    10-15 fg=fg bg=background
    16-18 fg=muted bg=background
"│ x | y │ either  │"
    0-1 fg=muted bg=background
    2-6 fg=fg bg=background
    7-9 fg=muted bg=background
    10-15 fg=fg bg=background
    16-18 fg=muted bg=background
"└───────┴─────────┘"
    0-18 fg=muted bg=background
